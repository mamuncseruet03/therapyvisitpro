DATABASE_URL="postgresql://postgres:postgres@localhost:5432/therapyvisit?schema=public"

AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"

# Leave unset while the API is served from the same Next.js app as the
# frontend (default: relative paths, e.g. /api/v1/patients). Set this
# only if the API moves to a separate origin/deployment, e.g.:
# NEXT_PUBLIC_API_URL="https://api.example.com"

# NOT YET USED — required to fix the file-upload PHI exposure gap
# (see docs/ARCHITECTURE.md "Known gaps"). Uploads currently land in
# public/uploads/ and are served statically with no read-side auth;
# fixing this means migrating to S3 (or an S3-compatible service)
# with signed/expiring URLs. Needs real credentials before that work
# can start — provide these (or the equivalent for another provider):
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_REGION=""
# S3_BUCKET_NAME=""
